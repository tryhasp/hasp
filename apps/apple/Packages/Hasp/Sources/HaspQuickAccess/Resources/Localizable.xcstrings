    "qa.confirm.native %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 사용자 이름과 비밀번호를 입력해요. 저장된 주소는 %2$@예요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Types the username and password into %1$@. The saved address is %2$@."
          }
        }
      }
    },
    "qa.confirm.browser %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 화면의 주소는 확인할 수 없어요. 저장된 주소는 %2$@예요. 맞는 페이지인지 보고 입력하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page address in %1$@ cannot be verified. The saved address is %2$@. Check the page, then type."
          }
        }
      }
    },
    "qa.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 필요해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access needed"
          }
        }
      }
    },
    "qa.accessibility.body": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에 입력하려면 시스템 설정의 손쉬운 사용에서 Hasp를 켜 주세요. 켜지 않아도 복사는 쓸 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To type into other apps, turn on Hasp in System Settings under Accessibility. Copying works without it."
          }
        }
      }
    },
    "qa.accessibility.open": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 열기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        }
      }
    },
