    "qa.locked.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠겨 있어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked"
          }
        }
      }
    },
    "qa.locked.body": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasp에서 잠금을 풀면 바로 쓸 수 있어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Hasp to use Quick Access"
          }
        }
      }
    },
    "qa.locked.action": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasp 열기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hasp"
          }
        }
      }
    },
    "qa.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 입력할까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type here?"
          }
        }
      }
    },
    "qa.confirm.action": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        }
      }
