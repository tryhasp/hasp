        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 패스키를 %@ 계정으로 저장할까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a passkey for %@ as %@?"
