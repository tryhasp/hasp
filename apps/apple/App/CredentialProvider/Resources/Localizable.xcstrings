    "provider.failed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청을 끝내지 못했어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasp could not finish this request"
          }
        }
      }
    },
    "provider.fill.action": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채우기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill"
          }
        }
      }
    },
    "provider.fill.body %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 로그인 정보를 %@에 채울까요? 주소를 확인하세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the login %@ on %@? Check the address."
          }
        }
      }
    },
    "provider.openApp": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasp 앱을 열어 다시 로그인해 주세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hasp and sign in again"
          }
        }
      }
    },
    "provider.passwordOnly": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 마스터 비밀번호로만 열려서 여기서는 열 수 없어요. Hasp 앱에서 열고, 기기 암호를 설정하면 Face ID로 쓸 수 있어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device opens with the master password only, so it cannot open here. Open the Hasp app, and set a device passcode to use Face ID"
          }
        }
      }
    },
    "provider.retry": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "provider.save.action": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
