          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "provider.empty": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞는 항목이 없어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching items"
