    "m.advice.passcode.body": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 암호를 설정하면 Face ID로 열 수 있어요. 지금은 열 때마다 마스터 비밀번호를 입력해요. 설정 앱의 Face ID 및 암호에서 만들 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a device passcode you can open Hasp with Face ID. For now you enter the master password each time. Create one in Settings under Face ID & Passcode."
          }
        }
      }
    },
