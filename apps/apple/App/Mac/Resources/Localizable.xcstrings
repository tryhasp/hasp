            "state": "translated",
            "value": "Allow Accessibility"
          }
        }
      }
    },
    "quick.access.why": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 입력창에 아이디와 비밀번호를 직접 입력하려면 손쉬운 사용 권한이 필요해요. 이 권한은 입력 위치가 비밀번호 칸인지 확인하고 글자를 입력하는 데만 써요. 화면을 읽거나 저장하지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing a login into another app needs the Accessibility permission. Hasp uses it only to check whether the focused field is a password field and to type the characters. It does not read or store anything on screen."
          }
        }
      }
    },
    "quick.intro.hotkey %@": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서든 %@ 를 누르면 로그인 정보를 바로 찾아 입력할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ in any app to find and fill a login."
