    "m.autofill.enable": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 일반 > 자동 완성 및 암호에서 Hasp를 켜면 Safari와 다른 앱에서 비밀번호, 패스키, 인증 코드를 채울 수 있어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Hasp in Settings > General > AutoFill & Passwords to fill passwords, passkeys and verification codes in Safari and other apps"
          }
        }
      }
    },
    "m.autofill.needsPaidTeam": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드는 무료 개발자 계정으로 서명돼서 자동 완성을 쓸 수 없어요. 앱 그룹과 자격 증명 제공자 권한은 유료 Apple Developer 계정이 필요해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build is signed with a free developer account, so AutoFill is unavailable. The app group and the credential provider entitlement need a paid Apple Developer account"
          }
        }
      }
    },
