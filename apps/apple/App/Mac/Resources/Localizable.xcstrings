        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호는 기기를 떠나지 않아요. 해시 앞 5글자만 haveibeenpwned.com에 보내고, 나머지는 이 기기에서 비교해요. 비슷한 비밀번호가 있는지는 추측될 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords never leave this device. Only the first 5 characters of a hash go to haveibeenpwned.com and the rest is compared here. A similar password could still be inferred."
          }
        }
      }
    },
