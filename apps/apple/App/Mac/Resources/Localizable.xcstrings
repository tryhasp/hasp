    "quick.intro.without": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하지 않아도 빠른 접근은 열려요. 이때는 입력 대신 비밀번호를 복사하고, 30초 뒤에 지워요."
          }
